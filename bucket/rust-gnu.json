{
    "version": "1.100.1",
    "description": "A language empowering everyone to build reliable and efficient software. (GNU toolchain, with rustfmt and clippy on PATH)",
    "homepage": "https://www.rust-lang.org",
    "license": "MIT|Apache-2.0",
    "notes": "main/rust-gnu with rustfmt and clippy shimmed, so `cargo fmt` and `cargo clippy` work. rust-analyzer is left to main/rust-analyzer.",
    "architecture": {
        "64bit": {
            "url": "https://static.rust-lang.org/dist/rust-1.100.1-x86_64-pc-windows-gnu.msi",
            "hash": "9b19bf96eecf04cb109baa662abf0617efe5f7ec30b0438c4d8b67bd72d90b8d"
        }
    },
    "extract_dir": "Rust",
    "bin": [
        "bin\\rustc.exe",
        "bin\\rustdoc.exe",
        "bin\\cargo.exe",
        "bin\\rustfmt.exe",
        "bin\\cargo-fmt.exe",
        "bin\\cargo-clippy.exe",
        "bin\\clippy-driver.exe"
    ],
    "checkver": {
        "url": "https://www.rust-lang.org/",
        "regex": "Version ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://static.rust-lang.org/dist/rust-$version-x86_64-pc-windows-gnu.msi"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
